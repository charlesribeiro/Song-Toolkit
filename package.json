{
  "name": "song-toolkit",
  "version": "1.0.0",
  "type": "module",
  "description": "432 Hz audio conversion API - convert MP3/WAV from 440 Hz to 432 Hz",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && cd frontend && npm run build",
    "build:backend": "tsc",
    "build:frontend": "cd frontend && npm run build",
    "start": "node dist/index.js",
    "clean": "rm -rf dist"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "audio",
    "432hz",
    "ffmpeg",
    "conversion"
  ],
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^22.9.0",
    "pm2": "^6.0.14",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3"
  }
}
